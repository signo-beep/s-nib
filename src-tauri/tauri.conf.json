{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s-nib",
  "version": "0.4.0",
  "identifier": "ch.ssigno.s-nib",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "s-nib",
        "width": 1000,
        "height": 760,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "signo",
    "copyright": "Copyright (c) 2026 signo",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "shortDescription": "WYSIWYG Markdown editor",
    "longDescription": "Open source WYSIWYG Markdown editor: inline syntax under the cursor, images, math formulas, Mermaid diagrams, HTML and PDF export.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "section": "editors",
        "desktopTemplate": "linux/s-nib.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
